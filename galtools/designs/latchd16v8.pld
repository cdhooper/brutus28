Device   g16v8;

/* Test design: GAL16V8, a register whose input reads a latch, which galre
   does not model */

Pin 1  = CLK;
Pin 2  = S;
Pin 3  = R;
Pin 4  = D;
Pin 11 = !OE;
Pin 17 = L;
Pin 18 = Q;

Q.d = D & L;
L = S & !R
  # L & !R;
