Name     osc16v8;
Partno   x;
Date     2026-11-19;
Revision 1;
Designer galtools;
Company  x;
Assembly x;
Location x;
Device   g16v8ma;

/* Test design: GAL16V8, an output that feeds back inverted: while EN is
   high and STOP low, R is its own complement and oscillates (a ring
   oscillator of one gate).  A level read then is arbitrary, and galre
   must say so. */

Pin 2  = EN;
Pin 3  = STOP;
Pin 4  = A;
Pin 17 = Y;
Pin 18 = R;

R = !EN & !STOP
  # !R & !STOP;
Y = A & R;
